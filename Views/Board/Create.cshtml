@model TaskManagementMvc.Models.BoardColumn

@{
    ViewData["Title"] = "ایجاد ستون جدید";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4><i class="bi bi-plus-lg me-2"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Order" class="form-label"></label>
                    <input asp-for="Order" class="form-control" />
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsDoneColumn" />
                    <label class="form-check-label" asp-for="IsDoneColumn"></label>
                </div>
                <div class="mb-3">
                    <label asp-for="ProjectId" class="form-label"></label>
                    <select asp-for="ProjectId" class="form-control" asp-items="ViewBag.Projects"></select>
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">انصراف</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        ایجاد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
