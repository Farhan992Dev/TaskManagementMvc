@model TaskManagementMvc.Models.BoardColumn

@{
    ViewData["Title"] = "حذف ستون";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4><i class="bi bi-trash me-2"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <p>آیا از حذف ستون <strong>@Model.Name</strong> اطمینان دارید؟</p>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">انصراف</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        حذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
