@model TaskManagementMvc.Models.ViewModels.JuleSettingsViewModel

@{
    ViewData["Title"] = "Jule Settings";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="JuleSettings" method="post">
    <div class="form-group">
        <label asp-for="ApiKey" class="control-label"></label>
        <input asp-for="ApiKey" class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>
