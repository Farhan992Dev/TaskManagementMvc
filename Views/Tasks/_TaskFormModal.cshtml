@model TaskFormViewModel

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Task" : "Create Task";
}

<div class="modal-header">
    <h5 class="modal-title">
        @if (isEdit)
        {
            <i class="fas fa-edit me-2"></i>
            <span>@ViewData["Title"]</span>
        }
        else
        {
            <i class="bi bi-plus-circle me-2"></i>
            <span>@ViewData["Title"]</span>
        }
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="@(isEdit ? "editTaskForm" : "createTaskForm")" asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <input type="hidden" asp-for="ProjectId" />

    <div class="modal-body">
        @await Html.PartialAsync("_TaskFormFields", Model)

        @if (!isEdit)
        {
            <div class="mt-4">
                <label class="form-label fw-semibold"><i class="bi bi-paperclip me-2"></i>Attachments</label>
                <input type="file" name="files" class="form-control" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.zip" />
                <div class="form-text"><i class="bi bi-info-circle me-1"></i>You can select multiple files.</div>
            </div>
            <div class="mt-3">
                <label class="form-label fw-semibold"><i class="bi bi-chat-left-text me-2"></i>Initial Note</label>
                <textarea name="initialComment" class="form-control" rows="3" placeholder="Initial description or note..."></textarea>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-light fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-files"></i>
                    Attachments
                </div>
                <div class="card-body">
                    @if (Model.Attachments?.Any() == true)
                    {
                        <div class="list-group mb-3">
                            @foreach (var attachment in Model.Attachments)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-file-earmark text-muted fs-5 ms-2"></i>
                                        <div>
                                            <span class="fw-medium attachment-item">@attachment.FileName</span>
                                            <small class="text-muted d-block">@((attachment.FileSize / 1024.0).ToString("F1")) KB</small>
                                        </div>
                                    </div>
                                    <div class="btn-group">
                                        <a asp-action="DownloadAttachment" asp-controller="Tasks" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-primary">
                                            Download
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">No files have been added.</div>
                    }
                    <div class="input-group">
                        <input type="file" name="newFile" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.zip" />
                        <button class="btn btn-outline-secondary" type="submit" formaction="@Url.Action("UploadAttachment","Tasks", new { id = Model.Id })">
                            Upload
                        </button>
                    </div>
                    <div class="form-text mt-2">To add a new file, select it and then click upload.</div>
                </div>
            </div>
        }
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i>Cancel
        </button>
        @if (isEdit)
        {
            <button type="button" class="btn btn-info" id="send-to-jule-btn">
                <i class="bi bi-robot me-1"></i>Send to Jule
            </button>
        }
        <button type="submit" class="btn btn-primary">
            @if (isEdit)
            {
                <i class="fas fa-save me-1"></i>
                <span>Save Changes</span>
            }
            else
            {
                <i class="bi bi-check-circle me-1"></i>
                <span>Create</span>
            }
        </button>
    </div>
</form>
