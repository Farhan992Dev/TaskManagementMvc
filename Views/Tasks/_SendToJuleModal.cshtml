<div class="modal fade" id="send-to-jule-modal" tabindex="-1" aria-labelledby="send-to-jule-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="send-to-jule-modal-label">Send to Jule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="send-to-jule-form">
                    <div class="mb-3">
                        <label for="jule-source" class="form-label">Source Repository</label>
                        <select id="jule-source" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label for="jule-prompt" class="form-label">Prompt</label>
                        <textarea id="jule-prompt" class="form-control" rows="5" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="send-to-jule-submit">Send</button>
            </div>
        </div>
    </div>
</div>
