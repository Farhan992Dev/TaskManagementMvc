@model TaskManagementMvc.Models.ViewModels.SendToJuleViewModel
@{
    ViewData["Title"] = "ارسال تسک به Jule";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4><i class="bi bi-robot me-2"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-12">
                    <h5>جزئیات تسک</h5>
                    <dl class="row">
                        <dt class="col-sm-3">عنوان</dt>
                        <dd class="col-sm-9">@Model.Task.Title</dd>

                        <dt class="col-sm-3">توضیحات</dt>
                        <dd class="col-sm-9">@Model.Task.Description</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="SendToJule" method="post">
                <input type="hidden" asp-for="TaskId" />

                <div class="mb-3">
                    <label asp-for="RepositoryUrl" class="form-label">آدرس Git Repository</label>
                    <input asp-for="RepositoryUrl" class="form-control" placeholder="https://github.com/user/repo.git" />
                    <span asp-validation-for="RepositoryUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Prompt" class="form-label">دستور شما (Prompt)</label>
                    <textarea asp-for="Prompt" class="form-control" rows="8"></textarea>
                    <span asp-validation-for="Prompt" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Edit" asp-route-id="@Model.TaskId" class="btn btn-secondary me-2">بازگشت به تسک</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>
                        ارسال به Jule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
